{
  "name": "ddcs-vscode-extension",
  "displayName": "DDCS Extension",
  "description": "DDCS CNC programming in VS Code — visual blocks, wizards, live G-code, and toolpath preview.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ddcs.openWizard",
        "title": "DDCS: New Program",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ddcs.openWizard",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:web && npm run build:preview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:web": "esbuild web/src/extensionApp.js --bundle --outfile=web/dist/bundle.js --format=esm --external:./dropbox.js --external:./gdrive.js",
    "build:preview": "esbuild web/src/previewApp.js --bundle --outfile=web/dist/preview.js --format=esm --external:./dropbox.js --external:./gdrive.js"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.1.3"
  }
}
