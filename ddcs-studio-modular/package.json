{
  "name": "ddcs-studio",
  "version": "9.49.78",
  "description": "Modular G-code Generator for DDCS Expert M350 CNC Controller",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "npx http-server ./src -p 3000 --silent",
    "generate-vars": "node src/data/import_vars.js --input \"Variables-ENG 01-04-2025.csv\" --output src/data/default_vars.js",
    "svg:rename-gradients": "python \"src/assets/svg/rename_gradients.py\" --dir \"src/assets/svg\"",
    "prebundle": "npm run svg:rename-gradients",
    "bundle": "node scripts/bundle.cjs --src src",
    "build": "npm run bump-version && npm run generate-vars && npm run bundle",
    "bump-version": "node scripts/bump-version.cjs",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "cnc",
    "gcode",
    "ddcs",
    "m350",
    "probe",
    "ultimate-bee"
  ],
  "author": "Fr\u00e9d\u00e9ric",
  "license": "MIT",
  "files": [
    "src/app.js",
    "src/gcodeParser.js",
    "src/wizardManager.js",
    "src/ui/",
    "src/viz/",
    "src/data/",
    "src/engine/",
    "src/wizards/"
  ],
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  },
  "dependencies": {
    "xmldom": "^0.6.0"
  }
}