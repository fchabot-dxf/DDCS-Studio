# OS / editor cruft
desktop.ini
.DS_Store

# Python
__pycache__/
*.pyc

# Wrangler / Cloudflare cache
.wrangler/

# Dependencies / build output
node_modules/
output/
.venv/
.env

# Generated/temp build artifacts
**/scripts/tmp_bundle_check.js
**/tmp_commandDeck_transformed.js

# Desktop builds (PyInstaller) — artifacts only; build_*.ps1 + fairy_gateway.py are tracked
/build/
/dist/
/DDCS-Studio.exe
/benchgateway.exe
*.exe.old
*.spec

# fairy local-backend runtime data (created when the gateway runs with --backend local)
/_bridge_data/

# Google OAuth client SECRET — BYO uses only the PUBLIC client ID (baked into providers.js); the secret is
# NEVER committed or shipped. Keep the downloaded JSON here, ignored.
/secrets/
client_secret_*.json
google_oauth.json
**/google_oauth.json

# advisor/worker handoff — local per-session marker state
.handoff/

# handoff + session artifacts (never commit)
.proc/
.claude/
.anim-captures/

# t1381 sanitation — build outputs + test artifacts never tracked again
/fairy.exe
/dist/
/build/
__pycache__/
/DDCS-Studio.exe
*.exe.old
DDCS-Studio/tests/*.png
DDCS-Studio/scratchpad/

# ── Loop coordination state — NEVER track these ──────────────────────────────
# HANDOFF.md carries the LIVE turn counter and the ball. Tracking it means every
# merge or branch switch overwrites the live counter with whatever that branch last
# committed — which silently breaks both waiters (they only fire on a HIGHER turn).
# Happened 2026-08-07: a main->branch merge reset the counter 1617 -> 1561 and
# stalled the loop. Same for .handoff/ (the per-role waiter bookmarks).
HANDOFF.md
.handoff/

# Agent scratch probes — both the advisor and the worker write throwaway .mjs
# harnesses into DDCS-Studio/ while measuring. They are disposable by construction
# and neither seat reliably cleans up; ignore them rather than sweeping periodically.
DDCS-Studio/_*.mjs
DDCS-Studio/_*.js
DDCS-Studio/**/_zz*.js
.repro/

# brand/trace-wordmark.py's fetched WOFF2 cache — downloaded, not source; wordmarks.json is the declaration
brand/.font-cache/

# Vendor repo CLONES (M150S, M350-LiveG, M3X-M350-IoT-Bridge) - kept on disk as the raw
# source the Modbus register map was mined from. NOT tracked: they are git clones (nested
# .git), they are third-party code under their own licences, and the VALUE is already
# extracted into bridge/controllers/expert-m350/FINDINGS.md. Submodule them if they ever
# need to be authoritative.
scratch_repos/
