# OS / editor cruft
desktop.ini
.DS_Store

# Python
__pycache__/
*.pyc

# Wrangler / Cloudflare cache
.wrangler/

# Dependencies / build output
node_modules/
output/
.venv/
.env

# Generated/temp build artifacts
**/scripts/tmp_bundle_check.js
**/tmp_commandDeck_transformed.js

# Desktop builds (PyInstaller) — artifacts only; build_*.ps1 + fairy_gateway.py are tracked
/build/
/dist/
/DDCS-Studio.exe
/benchgateway.exe
*.exe.old
*.spec

# fairy local-backend runtime data (created when the gateway runs with --backend local)
/_bridge_data/

# Google OAuth client SECRET — BYO uses only the PUBLIC client ID (baked into providers.js); the secret is
# NEVER committed or shipped. Keep the downloaded JSON here, ignored.
/secrets/
client_secret_*.json

# advisor/worker handoff — local per-session marker state
.handoff/
